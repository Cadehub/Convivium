# ==============================================================
# CONVIVIUM HOME HOTEL — ENVIRONMENT VARIABLES CONFIGURATION (.env)
# ==============================================================
# IMPORTANT:
# - Do NOT commit real secrets or production keys into Git.
# - Duplicate this file as .env in your local environment.
# ==============================================================

# Supabase Project Configuration
# Found in Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-anon-key-here

# ImgBB API Key (Client-side upload for staff menu dish/drink images)
# Get a free key at https://api.imgbb.com/
# Note: Visible in browser, used exclusively by authenticated staff for menu picture uploads.
# If omitted, application works smoothly without image upload capability.
VITE_IMGBB_API_KEY=your-imgbb-api-key-here

# Firebase Cloud Messaging (Web Push) - PUBLIC web configuration only.
# Firebase Console > Project settings > General > Your apps (Web) and Cloud Messaging > Web Push certificates.
# NEVER put the Google service-account private key here: it belongs ONLY in the Supabase Edge Function secret FIREBASE_SERVICE_ACCOUNT.
# If omitted, the application works normally and notifications are simply unavailable.
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-firebase-web-app-id
VITE_FIREBASE_VAPID_KEY=your-web-push-public-vapid-key
